# The public origin, no trailing slash.
#
# Leave this UNSET for the free setup. Vercel injects
# VERCEL_PROJECT_PRODUCTION_URL on every deploy, so the canonical URL, the
# sitemap and the OG card all resolve to your-project.vercel.app on their own.
#
# Set it only after attaching a domain you own (Project -> Settings -> Domains,
# then Environment Variables -> Production). A domain is the one part of this
# that is not free: a .com.br runs about R$40/year, a .dev about US$12.
# NEXT_PUBLIC_SITE_URL=https://exemplo.com.br
