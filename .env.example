# The public origin, no trailing slash.
#
# Leave this UNSET. lib/site.ts already pins the published domain,
# https://mauricio-raposo.vercel.app, which is what the canonical, the og tags
# and the sitemap use.
#
# Set it only when a domain you own is attached (Project -> Settings -> Domains,
# then Environment Variables -> Production). A domain is the one part of this
# that is not free: a .com.br runs about R$40/year, a .dev about US$12.
# NEXT_PUBLIC_SITE_URL=https://exemplo.com.br
